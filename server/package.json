{
  "name": "tiny-paws-server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative multiplayer server for Tiny Paws.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "smoke": "tsx src/smoke/clientSmoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.7",
    "@colyseus/monitor": "^0.18.3",
    "@colyseus/schema": "^5.0.14",
    "@colyseus/tools": "^0.18.2",
    "@colyseus/ws-transport": "^0.18.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.2",
    "@colyseus/testing": "^0.18.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
